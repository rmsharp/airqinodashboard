# AirQino API credentials (contact info@airqino.it with your device serial number to request access)
AIRQINO_CLIENT_ID=
AIRQINO_CLIENT_SECRET=
AIRQINO_USERNAME=
AIRQINO_PASSWORD=

# Your station info (obtained from AirQino after registration)
AIRQINO_STATION_NAME=
AIRQINO_PROJECT_NAME=

# Serial connection (alternative to API)
# SERIAL_PORT=/dev/tty.usbmodem14201
# SERIAL_BAUD=9600

# Flask
FLASK_SECRET_KEY=change-me-to-something-random
