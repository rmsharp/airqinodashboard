# AirQino API credentials (contact info@airqino.it with your device serial number to request access)
AIRQINO_CLIENT_ID=
AIRQINO_CLIENT_SECRET=
AIRQINO_USERNAME=
AIRQINO_PASSWORD=

# Your station info (obtained from AirQino after registration)
AIRQINO_STATION_NAME=
AIRQINO_PROJECT_NAME=

# Serial connection (alternative to API)
# The AirQino REV6 board has NO USB port. You need a USB-to-TTL serial
# adapter (CP2102 or FT232RL) connected to the board's TX/RX pins.
# Set adapter to 3.3V logic. Wire: AirQino TX->Adapter RX, GND->GND.
# The adapter appears as /dev/tty.usbserial-XXXX (macOS) or /dev/ttyUSB0 (Linux).
# SERIAL_PORT=/dev/tty.usbserial-0001
# SERIAL_BAUD=9600

# Flask
FLASK_SECRET_KEY=change-me-to-something-random
